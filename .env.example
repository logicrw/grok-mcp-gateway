# Shell environment example. The gateway does not auto-load this file.
# Copy only the values you need into your shell or service environment.

PROXY_HOST=127.0.0.1
PROXY_PORT=9996
GROK_GATEWAY_PORT_AUTOSCAN=false
LOG_LEVEL=INFO

# Keep blank for loopback-only use. Set a strong value before non-loopback binds.
PROXY_API_KEY=
GROK_PROXY_AUTH_STATE=${HOME}/.local/state/grok-oauth-proxy/auth_state.json
# Used only by scripts/import_xai_oauth.py and scripts/export_xai_oauth.py.
# The running gateway does not poll this file.
HERMES_AUTH_PATH=${HOME}/.hermes/auth.json
TOKEN_REFRESH_WINDOW=300
UPSTREAM_RETRY_ATTEMPTS=2
UPSTREAM_RETRY_DELAY=1.0

GROK_PROXY_RETRIEVE_MODEL=grok-4.6

GROK_PROXY_RETRIEVE_RAW_MODEL=grok-composer-2.5-fast
GROK_GATEWAY_MCP_TOOL_ALLOWLIST=x_retrieve
GROK_PROXY_MCP_X_SEARCH_CONCURRENCY=3
GROK_PROXY_RETRIEVE_TOTAL_TIMEOUT_SECONDS=120
GROK_PROXY_RETRIEVE_STAGE_TIMEOUT_SECONDS=80
GROK_PROXY_FAST_STAGE_TIMEOUT_SECONDS=10
GROK_PROXY_SMART_STAGE_TIMEOUT_SECONDS=80
GROK_PROXY_RAW_STAGE_TIMEOUT_SECONDS=30
GROK_PROXY_RETRIEVE_MAX_TARGETS=5
GROK_PROXY_RETRIEVE_OEMBED_CONCURRENCY=3
GROK_GATEWAY_DEBUG_UPSTREAM_ERRORS=false

GROK_PROXY_AUTO_X_SEARCH=false
GROK_PROXY_X_SEARCH_ALLOWED_HANDLES=
GROK_PROXY_X_SEARCH_IMAGE_UNDERSTANDING=false
GROK_PROXY_X_SEARCH_VIDEO_UNDERSTANDING=false
